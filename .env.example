# =============================================================================
# ASR LABS AI Content Operating System — environment template
# Copy to .env and fill in real values. Never commit .env.
# Placeholder names only — no real secrets.
# =============================================================================

# --- App ---
APP_NAME=ASR_LABS_AI_STUDIO
APP_ENV=development
APP_DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Supabase / PostgreSQL ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Auth (server-side verification) ---
JWT_SECRET=YOUR_JWT_SECRET
JWT_ALGORITHM=HS256

# --- LLM / AI providers (backend only — never expose to frontend) ---
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o

# --- Voice / TTS ---
TTS_PROVIDER=YOUR_TTS_PROVIDER
TTS_API_KEY=YOUR_TTS_API_KEY

# --- Visual / image generation ---
IMAGE_PROVIDER=YOUR_IMAGE_PROVIDER
IMAGE_API_KEY=YOUR_IMAGE_API_KEY

# --- Video / FFmpeg ---
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe

# --- Storage ---
STORAGE_ROOT=./storage
# Optional object storage (later)
# S3_BUCKET=YOUR_BUCKET
# S3_REGION=YOUR_REGION
# S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# --- Publishing platforms (backend only) ---
YOUTUBE_CLIENT_ID=YOUR_YOUTUBE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=YOUR_YOUTUBE_CLIENT_SECRET
YOUTUBE_REFRESH_TOKEN=YOUR_YOUTUBE_REFRESH_TOKEN
# TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
# TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET
# INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN

# --- Observability ---
LOG_LEVEL=INFO
LOG_DIR=./logs
